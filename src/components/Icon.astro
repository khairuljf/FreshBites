---
// Simple line icons. Brand logos live in FacebookIcon / WhatsAppIcon.
export type TIconName = 'phone' | 'mail' | 'map-pin' | 'clock' | 'leaf' | 'truck' | 'cash';
type Props = { name: TIconName; class?: string };
const { name, class: className = 'h-5 w-5' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
	{
		name === 'phone' && (
			<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
		)
	}
	{
		name === 'mail' && (
			<>
				<rect x="2" y="4" width="20" height="16" rx="2" />
				<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
			</>
		)
	}
	{
		name === 'map-pin' && (
			<>
				<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
				<circle cx="12" cy="10" r="3" />
			</>
		)
	}
	{
		name === 'clock' && (
			<>
				<circle cx="12" cy="12" r="10" />
				<path d="M12 6v6l4 2" />
			</>
		)
	}
	{
		name === 'leaf' && (
			<>
				<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
				<path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
			</>
		)
	}
	{
		name === 'truck' && (
			<>
				<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" />
				<path d="M15 18H9" />
				<path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14" />
				<circle cx="17" cy="18" r="2" />
				<circle cx="7" cy="18" r="2" />
			</>
		)
	}
	{
		name === 'cash' && (
			<>
				<rect x="2" y="6" width="20" height="12" rx="2" />
				<circle cx="12" cy="12" r="2" />
				<path d="M6 12h.01M18 12h.01" />
			</>
		)
	}
</svg>
