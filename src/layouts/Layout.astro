---
import '../styles/global.css';

import SearchBox from '../components/SearchBox.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { CATEGORIES, NAV, SITE, waLink } from '../lib/site';

type Props = { title?: string; description?: string; jsonLd?: object };

const { description = SITE.description, jsonLd, title } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary_large_image" />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body class="flex min-h-screen flex-col">
		<header class="sticky top-0 z-40 border-b border-stone-200 bg-white/90 backdrop-blur">
			<div class="container-page flex h-16 items-center gap-4">
				<a href="/" class="flex shrink-0 items-center gap-2 text-xl font-extrabold tracking-tight text-brand-700">
					<span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-lg text-white" aria-hidden="true">🍃</span>
					{SITE.name}
				</a>

				<SearchBox id="search-desktop" class="mx-auto hidden w-full max-w-md md:block" />

				<nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Main">
					{
						NAV.map(item => (
							<a
								href={item.href}
								class:list={[
									'rounded-full px-3.5 py-2 text-sm font-medium transition',
									isActive(item.href) ? 'bg-brand-50 text-brand-700' : 'text-stone-600 hover:text-brand-700',
								]}
								aria-current={isActive(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>

				<button
					type="button"
					class="ml-auto flex h-10 w-10 items-center justify-center rounded-full text-stone-700 hover:bg-stone-100 lg:hidden"
					aria-label="Open menu"
					aria-expanded="false"
					aria-controls="mobile-menu"
					data-menu-toggle
				>
					<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M4 7h16M4 12h16M4 17h16"></path>
					</svg>
				</button>
			</div>

			<div class="container-page pb-3 md:hidden">
				<SearchBox id="search-mobile" />
			</div>

			<nav id="mobile-menu" class="hidden border-t border-stone-200 bg-white lg:hidden" aria-label="Mobile">
				<div class="container-page flex flex-col py-2">
					{
						NAV.map(item => (
							<a
								href={item.href}
								class:list={['rounded-lg px-3 py-3 font-medium', isActive(item.href) ? 'bg-brand-50 text-brand-700' : 'text-stone-700']}
							>
								{item.label}
							</a>
						))
					}
				</div>
			</nav>
		</header>

		<main class="flex-1">
			<slot />
		</main>

		<footer class="mt-20 bg-brand-900 text-brand-50">
			<div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
				<div>
					<p class="text-xl font-extrabold">{SITE.name}</p>
					<p class="mt-3 text-sm text-brand-100/80">{SITE.description}</p>
				</div>
				<div>
					<p class="font-semibold">Shop</p>
					<ul class="mt-3 space-y-2 text-sm text-brand-100/80">
						{
							CATEGORIES.map(c => (
								<li>
									<a href={`/products?category=${c.slug}`} class="hover:text-white">
										{c.name}
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<div>
					<p class="font-semibold">Company</p>
					<ul class="mt-3 space-y-2 text-sm text-brand-100/80">
						{
							NAV.map(item => (
								<li>
									<a href={item.href} class="hover:text-white">
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<div>
					<p class="font-semibold">Contact</p>
					<ul class="mt-3 space-y-2 text-sm text-brand-100/80">
						<li><a href={`tel:${SITE.phoneIntl}`} class="hover:text-white">📞 {SITE.phone}</a></li>
						<li><a href={waLink(`Hello ${SITE.name}!`)} target="_blank" rel="noopener" class="hover:text-white">💬 WhatsApp</a></li>
						<li><a href={`mailto:${SITE.email}`} class="break-all hover:text-white">✉️ {SITE.email}</a></li>
						<li>📍 {SITE.address}</li>
						<li>🕗 {SITE.hours}</li>
					</ul>
				</div>
			</div>
			<div class="border-t border-white/10 py-5 text-center text-xs text-brand-100/70">© {year} {SITE.name}. All rights reserved.</div>
		</footer>

		<a
			href={waLink(`Hello ${SITE.name}, I need some help.`)}
			target="_blank"
			rel="noopener"
			class="wa-pulse fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-lg"
			aria-label="Chat with us on WhatsApp"
		>
			<WhatsAppIcon class="h-7 w-7" />
		</a>

		<script>
			const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
			const menu = document.getElementById('mobile-menu');
			toggle?.addEventListener('click', () => {
				const open = menu?.classList.toggle('hidden') === false;
				toggle.setAttribute('aria-expanded', String(open));
			});
		</script>
	</body>
</html>
