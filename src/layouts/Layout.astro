---
import '../styles/global.css';

import FacebookIcon from '../components/FacebookIcon.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import SearchBox from '../components/SearchBox.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import YouTubeIcon from '../components/YouTubeIcon.astro';
import { CATEGORIES, NAV, SITE, waLink } from '../lib/site';

type Props = {
	title?: string;
	description?: string;
	/** Social-preview image (path or URL). Defaults to the logo. */
	image?: string;
	imageAlt?: string;
	ogType?: 'website' | 'product';
	/** Keep the page out of Google (search results, 404). */
	noindex?: boolean;
	jsonLd?: object | object[];
};

const { description = SITE.description, image, imageAlt, jsonLd, noindex = false, ogType = 'website', title } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.seoTitle;
const path = Astro.url.pathname.replace(/(\.html)?\/?$/, '').replace(/\/index$/, '') || '/';
// One clean URL per page (no trailing slash, no query string) so Google never sees duplicates.
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL(image ?? SITE.logo, SITE.url).href;
const ogImageAlt = imageAlt ?? `${SITE.name} logo`;

// Who we are — shown on every page so Google can build a knowledge panel for the shop.
const siteJsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'OnlineStore',
		'@id': `${SITE.url}/#organization`,
		name: SITE.name,
		url: SITE.url,
		logo: new URL(SITE.logo, SITE.url).href,
		image: new URL(SITE.logo, SITE.url).href,
		description: SITE.description,
		email: SITE.email,
		telephone: SITE.phoneIntl,
		address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressCountry: SITE.countryCode },
		areaServed: { '@type': 'Country', name: 'Bangladesh' },
		contactPoint: { '@type': 'ContactPoint', telephone: SITE.phoneIntl, contactType: 'customer service', availableLanguage: ['Bengali', 'English'] },
		sameAs: [SITE.facebook, SITE.youtube],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': `${SITE.url}/#website`,
		name: SITE.name,
		url: SITE.url,
		inLanguage: ['en', 'bn'],
		publisher: { '@id': `${SITE.url}/#organization` },
		potentialAction: {
			'@type': 'SearchAction',
			target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/search?q={search_term_string}` },
			'query-input': 'required name=search_term_string',
		},
	},
];
const allJsonLd = [...siteJsonLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#23571f" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
		/>
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
		{!noindex && <link rel="canonical" href={canonical} />}
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Social previews (Facebook, WhatsApp, Messenger, X) -->
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:locale:alternate" content="bn_BD" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		{allJsonLd.map(data => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
		{
			// Google Analytics — only on the live site, not in local development.
			import.meta.env.PROD && (
				<>
					<script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`} />
					<script is:inline define:vars={{ gaId: SITE.gaId }}>
						window.dataLayer = window.dataLayer || [];
						function gtag() {
							dataLayer.push(arguments);
						}
						gtag('js', new Date());
						gtag('config', gaId);
					</script>
				</>
			)
		}
	</head>
	<body class="flex min-h-screen flex-col">
		<a href="#main" class="sr-only z-[60] rounded-full bg-brand-700 px-4 py-2 text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>

		<div class="bg-brand-800 text-xs text-brand-50">
			<div class="container-page flex h-9 items-center justify-between gap-4">
				<p class="truncate">
					<span class="text-accent-400" aria-hidden="true">●</span> Get healthy food delivered right to your door
				</p>
				<div class="hidden shrink-0 items-center gap-5 sm:flex">
					<a href={`tel:${SITE.phoneIntl}`} class="flex items-center gap-1.5 font-medium transition hover:text-accent-400">
						<Icon name="phone" class="h-3.5 w-3.5" /> {SITE.phone}
					</a>
					<span class="h-3.5 w-px bg-white/20" aria-hidden="true"></span>
					<div class="flex items-center gap-3">
						<a href={SITE.facebook} target="_blank" rel="noopener" aria-label={`${SITE.name} on Facebook`} class="transition hover:scale-110">
							<FacebookIcon brand class="h-4 w-4" />
						</a>
						<a href={SITE.youtube} target="_blank" rel="noopener" aria-label={`${SITE.name} on YouTube`} class="transition hover:scale-110">
							<YouTubeIcon brand class="h-5 w-5" />
						</a>
					</div>
				</div>
			</div>
		</div>

		<header class="sticky top-0 z-40 border-b border-stone-200/80 bg-white/90 backdrop-blur">
			<div class="container-page flex h-20 items-center gap-4 md:h-24">
				<a href="/" class="flex shrink-0 items-center gap-3" aria-label={`${SITE.name} home`}>
					<Logo class="h-14 w-14 shadow-md shadow-brand-900/10 md:h-20 md:w-20" />
				</a>

				<SearchBox id="search" class="min-w-0 flex-1 md:mx-auto md:w-full md:max-w-md md:flex-initial" />

				<nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Main">
					{
						NAV.map(item => (
							<a
								href={item.href}
								class:list={[
									'whitespace-nowrap rounded-full px-3.5 py-2 text-sm font-semibold transition',
									isActive(item.href) ? 'bg-brand-50 text-brand-700' : 'text-stone-600 hover:text-brand-700',
								]}
								aria-current={isActive(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>

				<a
					href={waLink(`Hello ${SITE.name}, I would like to place an order.`)}
					target="_blank"
					rel="noopener"
					class="btn-accent hidden whitespace-nowrap xl:inline-flex"
				>
					<WhatsAppIcon class="h-4 w-4" /> Order now
				</a>

				<button
					type="button"
					class="ml-auto flex h-11 w-11 items-center justify-center rounded-full text-stone-700 hover:bg-brand-50 lg:hidden"
					aria-label="Open menu"
					aria-expanded="false"
					aria-controls="mobile-menu"
					data-menu-toggle
				>
					<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M4 7h16M4 12h16M4 17h16" data-icon-open></path>
						<path d="M6 6l12 12M18 6 6 18" class="hidden" data-icon-close></path>
					</svg>
				</button>
			</div>

			<nav id="mobile-menu" class="hidden border-t border-stone-200 bg-white lg:hidden" aria-label="Mobile">
				<div class="container-page flex flex-col gap-1 py-3">
					{
						NAV.map(item => (
							<a
								href={item.href}
								class:list={['rounded-xl px-3 py-3 font-semibold', isActive(item.href) ? 'bg-brand-50 text-brand-700' : 'text-stone-700 hover:bg-stone-50']}
								aria-current={isActive(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						))
					}
					<a href={waLink(`Hello ${SITE.name}, I would like to place an order.`)} target="_blank" rel="noopener" class="btn-accent mt-2 py-3">
						<WhatsAppIcon /> Order on WhatsApp
					</a>
				</div>
			</nav>
		</header>

		<main id="main" class="flex-1">
			<slot />
		</main>

		<footer class="relative mt-24 overflow-hidden bg-brand-900 text-brand-50">
			<div class="h-1.5 bg-gradient-to-r from-brand-700 via-leaf-500 to-accent-500" aria-hidden="true"></div>
			<div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
				<div>
					<a href="/" class="inline-flex items-center gap-3">
						<Logo class="h-16 w-16" />
						<span class="text-2xl font-extrabold"><span class="text-white">fresh</span><span class="text-accent-400">Bites</span></span>
					</a>
					<p class="mt-4 text-sm leading-relaxed text-brand-100/80">{SITE.description}</p>
					<div class="mt-5 flex gap-2">
						<a href={SITE.facebook} target="_blank" rel="noopener" aria-label="freshBites on Facebook" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 transition hover:bg-accent-500 hover:text-brand-950">
							<FacebookIcon class="h-4 w-4" />
						</a>
						<a href={waLink(`Hello ${SITE.name}!`)} target="_blank" rel="noopener" aria-label="freshBites on WhatsApp" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 transition hover:bg-accent-500 hover:text-brand-950">
							<WhatsAppIcon class="h-4 w-4" />
						</a>
					</div>
				</div>
				<div>
					<p class="font-bold text-accent-400">Shop</p>
					<ul class="mt-4 space-y-2.5 text-sm text-brand-100/80">
						{
							CATEGORIES.map(c => (
								<li>
									<a href={`/products?category=${c.slug}`} class="hover:text-white">
										{c.name}
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<div>
					<p class="font-bold text-accent-400">Company</p>
					<ul class="mt-4 space-y-2.5 text-sm text-brand-100/80">
						{
							NAV.map(item => (
								<li>
									<a href={item.href} class="hover:text-white">
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<div>
					<p class="font-bold text-accent-400">Contact</p>
					<ul class="mt-4 space-y-3 text-sm text-brand-100/80">
						<li>
							<a href={`tel:${SITE.phoneIntl}`} class="group flex items-center gap-3 hover:text-white">
								<span class="footer-icon"><Icon name="phone" class="h-4 w-4" /></span>
								{SITE.phone}
							</a>
						</li>
						<li>
							<a href={waLink(`Hello ${SITE.name}!`)} target="_blank" rel="noopener" class="group flex items-center gap-3 hover:text-white">
								<span class="footer-icon"><WhatsAppIcon class="h-4 w-4" /></span>
								WhatsApp
							</a>
						</li>
						<li>
							<a href={SITE.facebook} target="_blank" rel="noopener" class="group flex items-center gap-3 hover:text-white">
								<span class="footer-icon"><FacebookIcon class="h-4 w-4" /></span>
								Facebook
							</a>
						</li>
						<li>
							<a href={`mailto:${SITE.email}`} class="group flex items-center gap-3 hover:text-white">
								<span class="footer-icon"><Icon name="mail" class="h-4 w-4" /></span>
								<span class="break-all">{SITE.email}</span>
							</a>
						</li>
						<li class="flex items-center gap-3">
							<span class="footer-icon"><Icon name="map-pin" class="h-4 w-4" /></span>
							{SITE.address}
						</li>
						<li class="flex items-center gap-3">
							<span class="footer-icon"><Icon name="clock" class="h-4 w-4" /></span>
							{SITE.hours}
						</li>
					</ul>
				</div>
			</div>
			<div class="border-t border-white/10">
				<div class="container-page flex flex-col items-center justify-between gap-2 py-5 text-xs text-brand-100/70 sm:flex-row">
					<p>© {year} {SITE.name}. All rights reserved.</p>
					<p class="font-semibold uppercase tracking-[0.2em] text-leaf-500">{SITE.slogan.join(' • ')}</p>
				</div>
			</div>
		</footer>

		<a
			href={waLink(`Hello ${SITE.name}, I need some help.`)}
			target="_blank"
			rel="noopener"
			class="wa-pulse fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-lg"
			aria-label="Chat with us on WhatsApp"
		>
			<WhatsAppIcon class="h-7 w-7" />
		</a>

		<script>
			import Clarity from '@microsoft/clarity';
			import { SITE } from '../lib/site';

			// Only track the live site, not local development.
			if (import.meta.env.PROD) Clarity.init(SITE.clarityId);
		</script>

		<script>
			const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
			const menu = document.getElementById('mobile-menu');
			toggle?.addEventListener('click', () => {
				const open = menu?.classList.toggle('hidden') === false;
				toggle.setAttribute('aria-expanded', String(open));
				toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
				toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
				toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
			});
		</script>
	</body>
</html>
