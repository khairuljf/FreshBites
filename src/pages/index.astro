---
import { getCollection } from 'astro:content';

import ProductCard from '../components/ProductCard.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import Layout from '../layouts/Layout.astro';
import { CATEGORIES, SITE, waLink } from '../lib/site';

const products = await getCollection('products');
const featured = products.filter(p => p.data.featured).slice(0, 8);
const countByCategory = (slug: string) => products.filter(p => p.data.category === slug).length;

const perks = [
	{ icon: '🌱', title: 'Fresh every day', text: 'Sourced daily from trusted farms and bakeries.' },
	{ icon: '🚚', title: 'Fast delivery', text: 'Same-day delivery inside Dhaka for orders before 4 PM.' },
	{ icon: '💬', title: 'Easy WhatsApp ordering', text: 'Tap a button, send the message — we confirm in minutes.' },
	{ icon: '💵', title: 'Cash on delivery', text: 'Pay when your order arrives. No card needed.' },
];
---

<Layout jsonLd={{ '@context': 'https://schema.org', '@type': 'Store', name: SITE.name, telephone: SITE.phoneIntl, email: SITE.email }}>
	<section class="bg-gradient-to-br from-brand-50 via-white to-orange-50">
		<div class="container-page grid items-center gap-10 py-16 md:grid-cols-2 md:py-24">
			<div>
				<span class="inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">🍃 Farm fresh · Delivered daily</span>
				<h1 class="mt-5 text-4xl font-extrabold leading-tight tracking-tight text-stone-900 sm:text-5xl">
					Fresh food,<br /><span class="text-brand-600">delivered to your door.</span>
				</h1>
				<p class="mt-5 max-w-md text-lg text-stone-600">
					Fruits, vegetables, fresh bakes, snacks and drinks — order in seconds on WhatsApp and pay on delivery.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href="/products" class="btn-primary px-6 py-3 text-base">Shop now</a>
					<a href={waLink(`Hello ${SITE.name}, I would like to place an order.`)} target="_blank" rel="noopener" class="btn-whatsapp px-6 py-3 text-base">
						<WhatsAppIcon /> Order on WhatsApp
					</a>
				</div>
			</div>
			<div class="grid grid-cols-3 gap-3 sm:gap-4" aria-hidden="true">
				{
					['🥭', '🥐', '🍓', '🥦', '🧃', '🍪', '🍌', '🥚', '🍊'].map((e, i) => (
						<div class:list={['flex aspect-square items-center justify-center rounded-3xl bg-white text-5xl shadow-sm sm:text-6xl', i % 2 ? 'translate-y-3' : '']}>{e}</div>
					))
				}
			</div>
		</div>
	</section>

	<section class="container-page py-16">
		<div class="flex items-end justify-between gap-4">
			<h2 class="text-2xl font-bold text-stone-900 sm:text-3xl">Shop by category</h2>
			<a href="/products" class="text-sm font-semibold text-brand-700 hover:underline">View all →</a>
		</div>
		<div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
			{
				CATEGORIES.map(c => (
					<a href={`/products?category=${c.slug}`} class={`group flex flex-col items-center gap-2 rounded-2xl ${c.bg} p-6 text-center transition hover:shadow-md`}>
						<span class="text-5xl transition group-hover:scale-110" aria-hidden="true">{c.emoji}</span>
						<span class="font-semibold text-stone-900">{c.name}</span>
						<span class="text-xs text-stone-500">{countByCategory(c.slug)} items</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="container-page py-8">
		<div class="flex items-end justify-between gap-4">
			<h2 class="text-2xl font-bold text-stone-900 sm:text-3xl">Today's favourites</h2>
			<a href="/products" class="text-sm font-semibold text-brand-700 hover:underline">All products →</a>
		</div>
		<div class="mt-8 grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-3 lg:grid-cols-4">
			{featured.map(product => <ProductCard product={product} />)}
		</div>
	</section>

	<section class="container-page py-16">
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				perks.map(p => (
					<div class="rounded-2xl border border-stone-200 p-6">
						<span class="text-3xl" aria-hidden="true">{p.icon}</span>
						<h3 class="mt-3 font-semibold text-stone-900">{p.title}</h3>
						<p class="mt-1 text-sm text-stone-500">{p.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="container-page">
		<div class="flex flex-col items-center gap-5 rounded-3xl bg-brand-600 px-6 py-12 text-center text-white">
			<h2 class="text-2xl font-bold sm:text-3xl">Can't find what you need?</h2>
			<p class="max-w-lg text-brand-50">Message us on WhatsApp — we'll source it for you or suggest the best alternative.</p>
			<a href={waLink(`Hello ${SITE.name}, I'm looking for a product that's not on the website.`)} target="_blank" rel="noopener" class="btn bg-white px-6 py-3 text-base text-brand-700 hover:bg-brand-50">
				<WhatsAppIcon /> Chat with us
			</a>
		</div>
	</section>
</Layout>
