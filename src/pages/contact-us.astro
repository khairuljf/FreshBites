---
import FacebookIcon from '../components/FacebookIcon.astro';
import Icon from '../components/Icon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import Layout from '../layouts/Layout.astro';
import { SITE, waLink } from '../lib/site';

const channels = [
	{ href: waLink(`Hello ${SITE.name}!`), icon: 'whatsapp', label: 'WhatsApp', value: SITE.phone, external: true, tint: 'bg-whatsapp/15 text-[#128c4b]' },
	{ href: `tel:${SITE.phoneIntl}`, icon: 'phone', label: 'Call us', value: SITE.phone, external: false, tint: 'bg-brand-50 text-brand-700' },
	{ href: `mailto:${SITE.email}`, icon: 'mail', label: 'Email', value: SITE.email, external: false, tint: 'bg-accent-50 text-accent-700' },
	{ href: SITE.facebook, icon: 'facebook', label: 'Facebook', value: 'facebook.com/FreshBitesShop', external: true, tint: 'bg-[#1877f2]/10 text-[#1877f2]' },
];
---

<Layout
	title="Contact Us — Order on WhatsApp or Phone"
	description={`Contact ${SITE.name} on WhatsApp or call ${SITE.phone} to order honey, achar, lal atta and talbina. Cash on delivery all over Bangladesh. Open ${SITE.hours.toLowerCase()}.`}
>
	<section class="border-b border-brand-100 bg-gradient-to-r from-brand-50 to-accent-50">
		<div class="container-page py-12">
			<p class="eyebrow">We're here to help</p>
			<h1 class="mt-2 text-4xl font-bold text-brand-900">Contact Us</h1>
			<p class="mt-2 text-stone-600">Questions, bulk orders or feedback — we usually reply within a few minutes.</p>
		</div>
	</section>

	<section class="container-page grid gap-10 py-12 lg:grid-cols-5">
		<div class="space-y-4 lg:col-span-2">
			{
				channels.map(c => (
					<a
						href={c.href}
						target={c.external ? '_blank' : undefined}
						rel={c.external ? 'noopener' : undefined}
						class="group flex items-center gap-4 rounded-2xl border border-stone-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md"
					>
						<span class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-xl transition group-hover:scale-105 ${c.tint}`}>
							{c.icon === 'whatsapp' ? (
								<WhatsAppIcon class="h-6 w-6" />
							) : c.icon === 'facebook' ? (
								<FacebookIcon class="h-6 w-6" />
							) : (
								<Icon name={c.icon as 'phone' | 'mail'} class="h-6 w-6" />
							)}
						</span>
						<span class="min-w-0">
							<span class="block text-sm text-stone-500">{c.label}</span>
							<span class="block break-all font-semibold text-stone-900">{c.value}</span>
						</span>
					</a>
				))
			}
			<div class="space-y-3 rounded-2xl border border-stone-200 bg-white p-5 text-sm text-stone-600">
				<p class="flex items-center gap-3">
					<Icon name="map-pin" class="h-5 w-5 shrink-0 text-brand-700" />
					<span><strong class="text-stone-900">Address:</strong> {SITE.address}</span>
				</p>
				<p class="flex items-center gap-3">
					<Icon name="clock" class="h-5 w-5 shrink-0 text-brand-700" />
					<span><strong class="text-stone-900">Hours:</strong> {SITE.hours}</span>
				</p>
			</div>
		</div>

		<div class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm sm:p-8 lg:col-span-3">
			<h2 class="text-2xl font-bold text-brand-900">Send us a message</h2>
			<p class="mt-1 text-sm text-stone-500">Your message opens in WhatsApp, ready to send. Nothing is stored on this website.</p>

			<form class="mt-6 space-y-4" data-contact-form data-whatsapp={SITE.whatsapp} data-shop={SITE.name}>
				<div class="grid gap-4 sm:grid-cols-2">
					<label class="block text-sm font-medium text-stone-700">
						Your name
						<input name="name" required autocomplete="name" class="field" />
					</label>
					<label class="block text-sm font-medium text-stone-700">
						Phone (optional)
						<input name="phone" type="tel" autocomplete="tel" pattern="01[3-9][0-9]{8}" placeholder="01XXXXXXXXX" class="field" />
					</label>
				</div>
				<label class="block text-sm font-medium text-stone-700">
					Subject
					<select name="subject" class="field">
						<option>General question</option>
						<option>Place an order</option>
						<option>Bulk / corporate order</option>
						<option>Feedback</option>
					</select>
				</label>
				<label class="block text-sm font-medium text-stone-700">
					Message
					<textarea name="message" required rows="5" class="field"></textarea>
				</label>
				<button type="submit" class="btn-whatsapp w-full py-3.5 text-base sm:w-auto">
					<WhatsAppIcon /> Send on WhatsApp
				</button>
			</form>
		</div>
	</section>
</Layout>

<style>
	@reference "../styles/global.css";

	.field {
		@apply mt-1.5 w-full rounded-xl border border-stone-300 bg-white px-4 py-2.5 text-stone-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100;
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-contact-form]')!;

	form.addEventListener('submit', event => {
		event.preventDefault();
		const data = new FormData(form);
		const phone = String(data.get('phone') ?? '').trim();
		const lines = [
			`Hello ${form.dataset.shop},`,
			`Subject: ${data.get('subject')}`,
			`Name: ${data.get('name')}`,
			...(phone ? [`Phone: ${phone}`] : []),
			'',
			String(data.get('message')),
		];
		window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
	});
</script>
