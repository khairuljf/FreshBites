---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
	<section class="container-page flex flex-col items-center py-24 text-center">
		<span class="text-7xl" aria-hidden="true">🥕</span>
		<h1 class="mt-6 text-3xl font-extrabold text-stone-900">Page not found</h1>
		<p class="mt-2 text-stone-500">The page you're looking for doesn't exist or has moved.</p>
		<div class="mt-8 flex gap-3">
			<a href="/" class="btn-primary">Go home</a>
			<a href="/products" class="btn-outline">Browse products</a>
		</div>
	</section>
</Layout>
