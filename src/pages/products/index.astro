---
import { getCollection } from 'astro:content';

import ProductCard from '../../components/ProductCard.astro';
import Layout from '../../layouts/Layout.astro';
import { byOrder, CATEGORIES } from '../../lib/site';

const products = (await getCollection('products')).sort(byOrder);
---

<Layout
	title="Shop All Products — Honey, Achar, Lal Atta, Talbina & Sweets"
	description="Buy pure chaker modhu (honey), home-made mango and amra achar, whole wheat lal atta, talbina (jober chatu) and date-nut borfi online. Cash on delivery all over Bangladesh."
>
	<section class="border-b border-brand-100 bg-gradient-to-r from-brand-50 to-accent-50">
		<div class="container-page py-10">
			<nav class="text-sm text-stone-500" aria-label="Breadcrumb"><a href="/" class="hover:text-brand-700">Home</a> / Products</nav>
			<h1 class="mt-2 text-3xl font-bold text-brand-900 sm:text-4xl" data-heading>All Products</h1>
		</div>
	</section>

	<section class="container-page py-8">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 sm:mx-0 sm:flex-wrap sm:px-0" data-filters>
				<button type="button" data-filter="" class="filter-chip">All</button>
				{
					CATEGORIES.map(c => (
						<button type="button" data-filter={c.slug} class="filter-chip">
							<span aria-hidden="true">{c.emoji}</span> {c.name}
						</button>
					))
				}
			</div>
			<label class="flex shrink-0 items-center gap-2 text-sm text-stone-600">
				Sort
				<select data-sort class="rounded-full border border-stone-200 bg-white px-3 py-2 text-sm outline-none font-medium focus:border-brand-500 focus:ring-2 focus:ring-brand-100">
					<option value="">Popular first</option>
					<option value="name">Name (A–Z)</option>
					<option value="price-asc">Price: low to high</option>
					<option value="price-desc">Price: high to low</option>
				</select>
			</label>
		</div>

		<p class="mt-6 text-sm text-stone-500" data-count>{products.length} products</p>

		<div class="mt-4 grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-3 lg:grid-cols-4" data-grid>
			{products.map(product => <ProductCard product={product} />)}
		</div>

		<p class="hidden py-16 text-center text-stone-500" data-empty>No products in this category yet.</p>
	</section>
</Layout>

<style>
	@reference "../../styles/global.css";

	.filter-chip {
		@apply shrink-0 cursor-pointer whitespace-nowrap rounded-full border border-stone-200 bg-white px-4 py-2 text-sm font-semibold text-stone-700 transition hover:border-brand-500 hover:text-brand-700;
	}

	.filter-chip[aria-pressed='true'] {
		@apply border-brand-700 bg-brand-700 text-white shadow-sm;
	}
</style>

<script>
	import { CATEGORIES } from '../../lib/site';

	const grid = document.querySelector<HTMLElement>('[data-grid]')!;
	const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-product-card]'));
	const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
	const sortSelect = document.querySelector<HTMLSelectElement>('[data-sort]')!;
	const countEl = document.querySelector<HTMLElement>('[data-count]')!;
	const emptyEl = document.querySelector<HTMLElement>('[data-empty]')!;
	const heading = document.querySelector<HTMLElement>('[data-heading]')!;

	const price = (card: HTMLElement) => {
		const value = card.dataset.price;
		return value ? Number(value) : Number.POSITIVE_INFINITY; // "Ask for Price" sorts last
	};

	function render() {
		const params = new URLSearchParams(window.location.search);
		const category = params.get('category') ?? '';
		const sort = params.get('sort') ?? '';

		chips.forEach(chip => chip.setAttribute('aria-pressed', String(chip.dataset.filter === category)));
		sortSelect.value = sort;
		heading.textContent = CATEGORIES.find(c => c.slug === category)?.name ?? 'All Products';

		const sorted = [...cards].sort((a, b) => {
			if (sort === 'price-asc') return price(a) - price(b);
			if (sort === 'price-desc') return (price(b) === Infinity ? -1 : price(b)) - (price(a) === Infinity ? -1 : price(a));
			if (sort === 'name') return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
			return cards.indexOf(a) - cards.indexOf(b); // build order: `order`, then name
		});

		let visible = 0;
		sorted.forEach(card => {
			const show = !category || card.dataset.category === category;
			card.hidden = !show;
			if (show) visible++;
			grid.appendChild(card);
		});

		countEl.textContent = `${visible} product${visible === 1 ? '' : 's'}`;
		emptyEl.classList.toggle('hidden', visible > 0);
	}

	function updateUrl(key: string, value: string) {
		const params = new URLSearchParams(window.location.search);
		if (value) params.set(key, value);
		else params.delete(key);
		const query = params.toString();
		history.replaceState(null, '', query ? `?${query}` : window.location.pathname);
		render();
	}

	chips.forEach(chip => chip.addEventListener('click', () => updateUrl('category', chip.dataset.filter ?? '')));
	sortSelect.addEventListener('change', () => updateUrl('sort', sortSelect.value));

	render();
</script>
