---
import { getCollection } from 'astro:content';

import FacebookIcon from '../components/FacebookIcon.astro';
import Logo from '../components/Logo.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import Layout from '../layouts/Layout.astro';
import { CATEGORIES, SITE, waLink } from '../lib/site';

const products = await getCollection('products');

const stats = [
	{ label: 'Products', value: String(products.length) },
	{ label: 'Categories', value: String(CATEGORIES.length) },
	{ label: 'Delivery', value: 'All BD' },
	{ label: 'Pure & natural', value: '100%' },
];

const values = [
	{ icon: '🌱', title: 'Freshness first', text: 'We cook and stock in small batches, so nothing sits on a shelf for long.' },
	{ icon: '🤝', title: 'Honest sourcing', text: 'Honey, atta and other staples come from producers we know and trust.' },
	{ icon: '✅', title: 'Checked by hand', text: 'Every order is inspected and packed by our team before it leaves.' },
	{ icon: '♻️', title: 'Less waste', text: 'Reusable crates and paper packaging wherever we can.' },
];
---

<Layout
	title="About Us — Pure, Natural Food from Dhaka"
	description={`${SITE.name} is a small Dhaka food shop selling pure chaker modhu (honey), home-made achar, lal atta, talbina and traditional sweets — delivered all over Bangladesh.`}
>
	<section class="bg-gradient-to-br from-brand-50 via-cream to-accent-50">
		<div class="container-page py-16 text-center md:py-20">
			<Logo size="lg" class="mx-auto h-36 w-36 shadow-xl shadow-brand-900/10" />
			<p class="eyebrow mt-6">{SITE.slogan.join(' • ')}</p>
			<h1 class="mt-3 text-4xl font-bold text-brand-900 sm:text-5xl">About {SITE.name}</h1>
			<p class="mx-auto mt-5 max-w-2xl text-lg text-stone-600">
				We started {SITE.name} with a simple idea: everyone deserves fresh, honest food — without the market rush.
			</p>
		</div>
	</section>

	<section class="container-page grid items-center gap-12 py-16 md:grid-cols-2">
		<div class="prose-simple text-stone-700">
			<h2 class="mb-4 text-3xl font-bold text-brand-900">Our story</h2>
			<p>
				{SITE.name} began as a small home kitchen for neighbours in Dhaka. Today we offer pure honey, home-style pickles, red atta, talbina and
				traditional sweets — from producers we trust, delivered all over Bangladesh.
			</p>
			<p>
				We keep things simple: browse the website, tap a button to message us on WhatsApp, and we'll confirm your order in minutes. Pay in cash when it
				arrives.
			</p>
		</div>
		<div class="grid grid-cols-2 gap-4">
			{
				stats.map(s => (
					<div class="rounded-3xl border border-brand-100 bg-white p-6 text-center shadow-sm">
						<p class="font-display text-3xl font-bold text-accent-600">{s.value}</p>
						<p class="mt-1 text-sm text-stone-600">{s.label}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="container-page py-8">
		<h2 class="text-center text-3xl font-bold text-brand-900">What we stand for</h2>
		<div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				values.map(v => (
					<div class="rounded-3xl border border-stone-200 bg-white p-6 transition hover:shadow-md">
						<span class="text-3xl" aria-hidden="true">{v.icon}</span>
						<h3 class="mt-3 font-bold text-brand-900">{v.title}</h3>
						<p class="mt-1 text-sm text-stone-500">{v.text}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="container-page pt-12">
		<div class="flex flex-col items-center gap-4 rounded-[2rem] bg-brand-800 px-6 py-14 text-center text-white">
			<h2 class="text-2xl font-bold">Have a question?</h2>
			<p class="text-brand-100">We're happy to help — {SITE.hours.toLowerCase()}.</p>
			<div class="flex flex-wrap justify-center gap-3">
				<a href={waLink(`Hello ${SITE.name}!`)} target="_blank" rel="noopener" class="btn-accent"><WhatsAppIcon /> WhatsApp us</a>
				<a href={SITE.facebook} target="_blank" rel="noopener" class="btn border border-white/40 text-white hover:bg-white/10"><FacebookIcon /> Facebook</a>
				<a href="/contact-us" class="btn border border-white/60 text-white hover:bg-white/10">Contact page</a>
			</div>
		</div>
	</section>
</Layout>
